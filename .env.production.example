# ========================================
# Production Environment Variables Example
# ========================================
# 1. Copy this file to your production server/platform
# 2. Rename it to .env
# 3. Replace all placeholder values with your actual production secrets
# ========================================

# Application settings
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Authentication (NextAuth)
# Generate a new secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_super_secure_random_string_here
NEXTAUTH_URL=https://your-production-domain.com

# Database (Supabase PostgreSQL / Railway)
# For Prisma, use the connection pooling URL if available (usually port 6543 on Supabase)
DATABASE_URL=postgresql://user:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# OpenAI API
OPENAI_API_KEY=sk-proj-your_production_openai_api_key

# OAuth Providers (Production Client IDs)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

GITHUB_ID=your_production_github_client_id
GITHUB_SECRET=your_production_github_client_secret

# Rate Limiting & Analytics (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
