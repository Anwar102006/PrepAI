generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH MODELS (NextAuth.js v5 compatible)
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           Role      @default(USER)
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  interviews     Interview[]
  resumes        Resume[]
  submissions    CodingSubmission[]
  feedbacks      Feedback[]
  subscription   Subscription?
  analyticsCache UserAnalyticsCache?

  @@index([email])
  @@map("users")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// INTERVIEW MODELS
// ─────────────────────────────────────────────

model Interview {
  id          String          @id @default(cuid())
  userId      String
  type        InterviewType
  role        String
  company     String?
  difficulty  Difficulty      @default(MEDIUM)
  status      InterviewStatus @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  duration    Int?
  overallScore Float?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages InterviewMessage[]
  feedback Feedback?

  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id])

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("interviews")
}

enum InterviewType {
  BEHAVIORAL
  TECHNICAL
  SYSTEM_DESIGN
  HR
  MIXED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model InterviewMessage {
  id          String      @id @default(cuid())
  interviewId String
  role        MessageRole
  content     String      @db.Text
  audioUrl    String?
  timestamp   DateTime    @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, timestamp])
  @@map("interview_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─────────────────────────────────────────────
// RESUME MODELS
// ─────────────────────────────────────────────

model Resume {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis ResumeAnalysis?

  @@index([userId, createdAt])
  @@map("resumes")
}

model ResumeAnalysis {
  id            String   @id @default(cuid())
  resumeId      String   @unique
  overallScore  Float
  atsScore      Float
  contentScore  Float
  formatScore   Float
  skillsFound   String[]
  suggestions   Json
  strengths     String[]
  weaknesses    String[]
  rawAnalysis   String   @db.Text
  analyzedAt    DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analyses")
}

// ─────────────────────────────────────────────
// CODING INTERVIEW MODELS
// ─────────────────────────────────────────────

model CodingChallenge {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  difficulty  Difficulty
  category    String
  tags        String[]
  starterCode Json
  solution    String?    @db.Text
  hints       String[]
  timeLimit   Int        @default(30)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testCases   TestCase[]
  submissions CodingSubmission[]

  @@index([difficulty, category])
  @@index([isActive])
  @@map("coding_challenges")
}

model TestCase {
  id          String  @id @default(cuid())
  challengeId String
  input       String  @db.Text
  expected    String  @db.Text
  isHidden    Boolean @default(false)
  order       Int

  challenge CodingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("test_cases")
}

model CodingSubmission {
  id          String           @id @default(cuid())
  userId      String
  challengeId String
  language    String
  code        String           @db.Text
  status      SubmissionStatus @default(PENDING)
  runtime     Int?
  memory      Int?
  score       Float?
  aiReview    String?          @db.Text
  submittedAt DateTime         @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   CodingChallenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  testResults TestResult[]

  @@index([userId, challengeId])
  @@index([userId, submittedAt])
  @@map("coding_submissions")
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
}

model TestResult {
  id           String  @id @default(cuid())
  submissionId String
  testCaseId   String
  passed       Boolean
  actualOutput String? @db.Text
  runtime      Int?
  error        String? @db.Text

  submission CodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("test_results")
}

// ─────────────────────────────────────────────
// AI FEEDBACK
// ─────────────────────────────────────────────

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  interviewId   String   @unique
  overallScore  Float
  categories    Json
  strengths     String[]
  improvements  String[]
  detailedNotes String   @db.Text
  actionItems   String[]
  createdAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("feedbacks")
}

// ─────────────────────────────────────────────
// ANALYTICS CACHE
// ─────────────────────────────────────────────

model UserAnalyticsCache {
  id                String   @id @default(cuid())
  userId            String   @unique
  totalInterviews   Int      @default(0)
  avgScore          Float    @default(0)
  totalCodingSolved Int      @default(0)
  streakDays        Int      @default(0)
  lastActiveAt      DateTime @default(now())
  skillScores       Json     @default("{}")
  weeklyActivity    Json     @default("[]")
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics_cache")
}

// ─────────────────────────────────────────────
// ADMIN: QUESTION BANK
// ─────────────────────────────────────────────

model QuestionBank {
  id        String        @id @default(cuid())
  title     String
  type      InterviewType
  questions Json
  company   String?
  role      String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  interviews Interview[]

  @@index([type, isActive])
  @@map("question_banks")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION / BILLING
// ─────────────────────────────────────────────

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              Plan      @default(FREE)
  stripeCustomerId  String?   @unique
  stripeSubId       String?   @unique
  status            SubStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}
