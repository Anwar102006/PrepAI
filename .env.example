# ─── Database (MongoDB Replica Set or MongoDB Atlas) ───
# For Local Replica Set:
DATABASE_URL="mongodb://127.0.0.1:27018/prepai?replicaSet=rs0&directConnection=true"
# For MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/prepai?retryWrites=true&w=majority"

# ─── Redis ───
REDIS_URL="redis://localhost:6379"

# ─── NextAuth.js ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-me-in-production"

# ─── OAuth Providers ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── OpenAI ───
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ─── Storage (S3 / MinIO) ───
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="prepai-uploads"
STORAGE_REGION="us-east-1"

# ─── Stripe (Billing) ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
